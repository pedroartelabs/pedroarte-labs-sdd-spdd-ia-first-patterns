{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroartelabs/pedroarte-labs-sdd-spdd-ia-first-patterns/schemas/prompt-reasons.schema.json",
  "title": "SPDD REASONS prompt frontmatter",
  "description": "Validates the YAML frontmatter of a structured prompt. The REASONS body sections are validated by scripts/validate-prompts.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_id",
    "spec_id",
    "version",
    "status",
    "model_agnostic",
    "target_agent",
    "created_at",
    "approved_by"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^PROMPT-(?:[0-9]{4}-[0-9]{3}|EXAMPLE-[0-9]{3})$"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^SPEC-(?:[0-9]{4}-[0-9]{3}|EXAMPLE-[0-9]{3})$",
      "description": "A prompt is never free-floating: it always derives from a specification."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the prompt itself. A behavioural change to the prompt is a version bump."
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "SUPERSEDED", "RETIRED"]
    },
    "model_agnostic": {
      "type": "boolean",
      "description": "True when the prompt carries no vendor-specific syntax and can drive any capable coding agent."
    },
    "target_agent": {
      "type": "string",
      "enum": [
        "coding-agent",
        "review-agent",
        "architecture-agent",
        "test-agent",
        "documentation-agent"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 2,
      "description": "Human approver, or the literal string 'pending' while the prompt is not APPROVED."
    },
    "supersedes": {
      "type": "string",
      "pattern": "^PROMPT-(?:[0-9]{4}-[0-9]{3}|EXAMPLE-[0-9]{3})$"
    },
    "languages": {
      "type": "array",
      "items": { "type": "string", "enum": ["java", "python", "none"] }
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "change"],
        "properties": {
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "change": { "type": "string", "minLength": 5 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "APPROVED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approved_by": {
            "not": { "const": "pending" }
          }
        },
        "description": "An APPROVED prompt must name a real human approver."
      }
    }
  ]
}
