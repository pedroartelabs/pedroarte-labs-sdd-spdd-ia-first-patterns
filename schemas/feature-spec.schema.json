{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroartelabs/pedroarte-labs-sdd-spdd-ia-first-patterns/schemas/feature-spec.schema.json",
  "title": "Feature specification frontmatter",
  "description": "Validates the YAML frontmatter of every specification under specs/. The document body is validated separately by scripts/validate-specs.py, which checks required sections and state entry requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "type",
    "owner",
    "created_at",
    "updated_at",
    "languages",
    "bounded_context",
    "risk_level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SPEC-(?:[0-9]{4}-[0-9]{3}|EXAMPLE-[0-9]{3})$",
      "description": "SPEC-<year>-<sequence>, or SPEC-EXAMPLE-<sequence> for shipped reference specifications."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "IMPLEMENTING",
        "VERIFIED",
        "RELEASED",
        "REJECTED",
        "SUPERSEDED",
        "DEPRECATED",
        "CANCELLED",
        "HOTFIX"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "bug-fix",
        "hotfix",
        "architecture-change",
        "refactoring",
        "documentation"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "created_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["java", "python", "none"]
      }
    },
    "bounded_context": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase kebab-case name of the bounded context this specification belongs to."
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "related_adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4}$"
      },
      "default": []
    },
    "related_issues": {
      "type": "array",
      "items": {
        "type": ["string", "integer"]
      },
      "default": []
    },
    "prompt_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PROMPT-(?:[0-9]{4}-[0-9]{3}|EXAMPLE-[0-9]{3})$"
      },
      "default": []
    },
    "supersedes": {
      "type": "string",
      "pattern": "^SPEC-(?:[0-9]{4}-[0-9]{3}|EXAMPLE-[0-9]{3})$"
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^SPEC-(?:[0-9]{4}-[0-9]{3}|EXAMPLE-[0-9]{3})$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SUPERSEDED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["superseded_by"],
        "description": "A superseded specification must name its replacement."
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["IMPLEMENTING", "VERIFIED", "RELEASED"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "prompt_artifacts": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["prompt_artifacts"],
        "description": "From IMPLEMENTING onward a versioned SPDD prompt must be linked."
      }
    }
  ]
}
