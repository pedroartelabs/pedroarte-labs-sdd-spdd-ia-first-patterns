root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java}]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,md,mdc}]
indent_size = 2

[*.md]
# Two trailing spaces are a legitimate hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.xml]
indent_size = 2
max_line_length = 140
